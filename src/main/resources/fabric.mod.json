{
  "schemaVersion": 1,
  "id": "mmblocks",
  "version": "${version}",
  "name": "Mapmakerblocks",
  "description": "Mapmakerblocks - a Minecraft mod by Putzwirk.",
  "authors": [
    "Putzwirk"
  ],
  "license": "MIT",
  "icon": "assets/mmblocks/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.putzwirk.mapmakerblocks.Mapmakerblocks"
    ],
    "client": [
      "com.putzwirk.mapmakerblocks.client.MapmakerblocksClient"
    ],
    "fabric-datagen": [
      "com.putzwirk.mapmakerblocks.client.MapmakerblocksDataGenerator"
    ]
  },
  "mixins": [
    "mapmakerblocks.mixins.json",
    {
      "config": "mapmakerblocks.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  }
}